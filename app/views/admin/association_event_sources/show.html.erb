<div class="container">
  <div class="row">
    <div class="col-xs-offset-1 col-xs-10">
      <ol class="breadcrumb">
        <li><%= link_to "Agendas des associations", admin_association_event_sources_path %></li>
        <li><%= @association_event_source.name %></li>
      </ol>

      <div class="h1" style="display: flex; align-items: center;">
        <div style="flex-grow: 1">
          <%= @association_event_source.name %>
          <span class="label label-default"><%= source_provider_label(@association_event_source.provider) %></span>
          <%= render partial: 'admin/association_event_sources/status_badge', locals: { source: @association_event_source } %>
        </div>
        <%= button_to "Synchroniser maintenant", sync_admin_association_event_source_path(@association_event_source), class: "btn btn-default" %>
        <%= link_to "Modifier", edit_admin_association_event_source_path(@association_event_source), class: "btn btn-default" %>
      </div>

      <div class="row">
        <div class="col-md-5">
          <table class="table">
            <tr>
              <th style="width: 40%;">Ville</th>
              <td><%= @association_event_source.city.presence || '—' %></td>
            </tr>
            <tr>
              <th>Association liée</th>
              <td>
                <% if @association_event_source.partner %>
                  <%= link_to @association_event_source.partner.name, [:admin, @association_event_source.partner] %>
                <% else %>
                  <span class="text-muted">Non mappée — </span>
                  <%= link_to "modifier pour lier une association", edit_admin_association_event_source_path(@association_event_source) %>
                <% end %>
              </td>
            </tr>
            <tr>
              <th>Lieu (POI)</th>
              <td>
                <% if @association_event_source.poi %>
                  <%= link_to @association_event_source.poi.name, edit_admin_poi_path(@association_event_source.poi) %>
                  <br><span class="text-muted">Tous les événements de cette source sont rattachés à ce lieu.</span>
                <% else %>
                  <span class="text-muted">Non renseigné — rattachement événement par événement par proximité géographique (<%= @association_event_source.association_events.where.not(poi_id: nil).count %>/<%= @association_event_source.association_events.count %> événements rattachés)</span>
                <% end %>
              </td>
            </tr>
            <tr>
              <th><%= source_provider_label(@association_event_source.provider) %></th>
              <td><%= render partial: 'admin/association_event_sources/external_identifier', locals: { source: @association_event_source } %></td>
            </tr>
            <tr>
              <th>Dernière vérification</th>
              <td><%= @association_event_source.last_checked_at&.strftime('%d/%m/%Y %H:%M') || 'jamais' %></td>
            </tr>
            <tr>
              <th>Dernière synchro réussie</th>
              <td><%= @association_event_source.last_synced_at&.strftime('%d/%m/%Y %H:%M') || '—' %></td>
            </tr>
            <% if @association_event_source.last_error.present? %>
              <tr>
                <th>Dernière erreur</th>
                <td class="text-danger"><%= @association_event_source.last_error %></td>
              </tr>
            <% end %>
            <% if @association_event_source.notes.present? %>
              <tr>
                <th>Notes</th>
                <td><%= simple_format(@association_event_source.notes) %></td>
              </tr>
            <% end %>
          </table>

          <%= link_to "Supprimer cette source", [:admin, @association_event_source], method: :delete, class: "text-danger", data: { confirm: "Supprimer la source \"#{@association_event_source.name}\" ?" } %>
        </div>

        <div class="col-md-7">
          <h2>Calendrier des événements à venir (<%= @upcoming_events.size %>)</h2>

          <% if @association_event_source.status != 'exploitable' %>
            <p class="text-muted">
              Cette source n'est pas marquée comme exploitable — synchronisez-la pour tenter de récupérer ses événements.
            </p>
          <% end %>

          <% if @upcoming_events.empty? %>
            <p class="text-muted">Aucun événement à venir pour cette source pour le moment.</p>
          <% else %>
            <% @upcoming_events.group_by { |event| event.starts_at.to_date }.each do |date, events_for_day| %>
              <div style="margin-bottom: 18px;">
                <strong><%= date.strftime('%A %d %B %Y').capitalize %></strong>
                <table class="table" style="margin-top: 6px;">
                  <% events_for_day.each do |event| %>
                    <tr>
                      <td style="width: 90px;"><%= event.starts_at.strftime('%H:%Mh') %></td>
                      <td>
                        <strong><%= event.title %></strong>
                        <% if event.is_free == true %>
                          <span class="label label-success">Gratuit (déclaré)</span>
                        <% elsif event.is_free == false %>
                          <span class="label label-danger">Payant (déclaré)</span>
                        <% else %>
                          <span class="label label-default">Gratuité non renseignée</span>
                        <% end %>
                        <% if event.organizer_name.present? && event.organizer_name != @association_event_source.name %>
                          <br><span class="text-muted">Organisateur d'origine : <%= event.organizer_name %></span>
                        <% end %>
                        <% if event.location.present? %>
                          <br><span class="text-muted"><%= event.location %></span>
                        <% end %>
                        <% if event.poi.present? %>
                          <br><span class="label label-info">POI : <%= link_to event.poi.name, edit_admin_poi_path(event.poi) %></span>
                        <% end %>
                        <% if event.description.present? %>
                          <br><span class="text-muted"><%= truncate(event.description, length: 140) %></span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </table>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
