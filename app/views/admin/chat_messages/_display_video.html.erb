<% if @chat_message.video_url.present? %>
  <div id="chat-message-video-<%= @chat_message.id %>" style="margin-bottom: 15px">
    <iframe src="<%= @chat_message.video_url %>" width="320" height="180" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
  </div>
<% else %>
  <div id="chat-message-video-<%= @chat_message.id %>" hidden="hidden"></div>
<% end %>
