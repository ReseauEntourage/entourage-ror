<style>
  .conversations-menu {
    height: calc(100vh - 350px);
    overflow-y: auto;
    border-right: 1px solid var(--bo-line);
  }

  .conversation.unread {
    font-weight: bold;
  }

  .conversation-unread-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bo-danger);
    margin-right: 6px;
    vertical-align: middle;
  }

  .conversation-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 10px;
    transition: background-color 0.3s;
  }

  .conversation-link:hover {
    background: var(--bo-paper);
  }

  .conversation {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--bo-line);
    padding: 10px;
  }

  .conversation-avatar {
    flex: 0 0 auto;
    margin-right: 10px;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .conversation-details {
    flex: 1;
  }

  .conversation-recipients {
    font-weight: bold;
    margin-bottom: 5px;
  }

  .conversation-message {
    color: var(--bo-ink-soft);
  }

  .conversation-date {
    flex: 0 0 auto;
    font-size: 0.8em;
    color: var(--bo-ink-faint);
  }

  .nav-tabs-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .conversation-buttons {
    display: flex;
    gap: 10px;
  }

  .nav-tabs {
    margin-bottom: 0;
  }

  .conversation-messages-container {
    max-height: 400px;
    overflow-y: auto;
    padding-right: 15px;
  }

  .conversation-day-divider, .conversation-message {
    margin-bottom: 15px;
  }

</style>

<div class="container">
  <h1>Messages privés</h1>

  <div style="margin-bottom: 15px">
    <div class="btn-group btn-group-sm">
      <%= link_to "Tous", @params.except(:filter), class: "btn btn-#{params.key?(:filter) ? :default : :primary}" %>
      <%= link_to "Non-lus (#{@unread_count})", @params.merge(filter: :unread), class: "btn btn-#{params[:filter] == 'unread' ? :primary : :default}" %>
    </div>

    <%= link_to "Archivés", @params.merge(filter: :archived), class: "btn btn-#{params[:filter] == 'archived' ? :primary : :default} btn-sm" %>

    <%= button_to "Marquer toutes les conversations comme lues", read_all_admin_conversations_path, method: :post, class: "btn btn-warning btn-sm", form: { style: "float: right; padding-left: 20px" } %>

    <%= button_to "Créer une conversation", new_admin_conversation_path, method: :get, class: "btn btn-success btn-sm", form: { style: "float: right;" } %>
  </div>

  <div style="padding-bottom: 50px">
    <%= form_tag admin_conversations_path, remote: true, method: :get, html: { role: "form" } do |f| %>
      <%= text_field_tag :search, params[:search], class: "form-control", style: "width: 400px;", placeholder: "Recherche par participant" %>

      <% @params.each do |key, value| %>
        <% unless key.to_sym == :search %>
          <%= hidden_field_tag key, value %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="conversations-list">
    <%= render partial: 'conversations', locals: { conversations: @conversations } %>
  </div>
</div>
