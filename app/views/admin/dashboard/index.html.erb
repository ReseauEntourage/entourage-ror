<div class="container">
  <div class="h1" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px">
    <span>Tableau de bord</span>

    <% if @departments.any? %>
      <div class="btn-group btn-group-sm">
        <%= link_to "Ma zone (#{@departments.join(', ')})", admin_dashboard_path(zone: 'mine'), class: "btn btn-#{@zone == :mine ? :primary : :default}" %>
        <%= link_to "Toute la plateforme", admin_dashboard_path(zone: 'all'), class: "btn btn-#{@zone == :all ? :primary : :default}" %>
      </div>
    <% end %>
  </div>

  <div class="panel panel-default">
    <div class="panel-heading">Activité récente<% if @zone == :mine %> — départements <%= @departments.join(', ') %><% end %></div>
    <div class="panel-body" style="overflow-x: auto">
      <table class="table admin-table custom-table" style="table-layout: auto; min-width: 560px">
        <thead>
          <th>Indicateur</th>
          <% @activity.each do |row| %>
            <th style="text-align: center">Depuis <%= row[:days] %> jour<%= 's' if row[:days] > 1 %></th>
          <% end %>
        </thead>
        <tbody>
          <tr>
            <td>Nouveaux comptes</td>
            <% @activity.each do |row| %>
              <td style="text-align: center">
                <%= link_to row[:new_users], admin_users_path(q: { created_at_gteq: row[:days].days.ago.to_date, postal_code_start_any: (@zone == :mine ? @departments : nil) }) %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td>Dont avec photo de profil</td>
            <% @activity.each do |row| %>
              <td style="text-align: center"><%= row[:new_profile_photos] %></td>
            <% end %>
          </tr>
          <tr>
            <td>Nouvelles actions / événements</td>
            <% @activity.each do |row| %>
              <td style="text-align: center">
                <%= link_to row[:new_entourages], admin_entourages_path(q: { created_at_gteq: row[:days].days.ago.to_date, postal_code_start_any: (@zone == :mine ? @departments : nil) }) %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td>Dont non modérés</td>
            <% @activity.each do |row| %>
              <td style="text-align: center">
                <% if row[:new_unmoderated_entourages] > 0 %>
                  <%= link_to row[:new_unmoderated_entourages], admin_entourages_path(q: { created_at_gteq: row[:days].days.ago.to_date, postal_code_start_any: (@zone == :mine ? @departments : nil) }), class: "custom-badge warning" %>
                <% else %>
                  0
                <% end %>
              </td>
            <% end %>
          </tr>
          <tr>
            <td>Nouveaux groupes de voisins</td>
            <% @activity.each do |row| %>
              <td style="text-align: center"><%= row[:new_neighborhoods] %></td>
            <% end %>
          </tr>
          <tr>
            <td>Messages échangés</td>
            <% @activity.each do |row| %>
              <td style="text-align: center"><%= row[:new_messages] %></td>
            <% end %>
          </tr>
        </tbody>
      </table>
      <p class="text-muted" style="margin: 10px 0 0">
        « Dont non modérés » compte, parmi les actions/événements créés sur la période, ceux qui n'ont toujours pas été modérés à ce jour. « Dont avec photo de profil » n'indique pas un statut de modération (voir note plus bas).
      </p>
    </div>
  </div>

  <div class="row" style="display: flex; gap: 16px; flex-wrap: wrap; margin: 0 0 20px">
    <div class="panel <%= @pending_moderation_count > 0 ? 'panel-warning' : 'panel-default' %>" style="flex: 1; min-width: 200px">
      <div class="panel-body" style="text-align: center">
        <div style="font-size: 30px; font-weight: 600"><%= @pending_moderation_count %></div>
        <div class="text-muted">Actions/événements non modérés (total)</div>
      </div>
    </div>

    <div class="panel <%= @unassigned_count > 0 ? 'panel-warning' : 'panel-default' %>" style="flex: 1; min-width: 200px">
      <div class="panel-body" style="text-align: center">
        <div style="font-size: 30px; font-weight: 600"><%= link_to @unassigned_count, admin_entourages_path(moderator_id: :none) %></div>
        <div class="text-muted">Sans modérateur assigné</div>
      </div>
    </div>

    <div class="panel panel-default" style="flex: 1; min-width: 200px">
      <div class="panel-body" style="text-align: center">
        <div style="font-size: 30px; font-weight: 600">
          <% if @avg_moderation_days %>
            <%= @avg_moderation_days %>j
          <% else %>
            &mdash;
          <% end %>
        </div>
        <div class="text-muted">Délai de modération moyen (7j)</div>
      </div>
    </div>

    <div class="panel panel-default" style="flex: 1; min-width: 200px">
      <div class="panel-body" style="text-align: center">
        <div style="font-size: 30px; font-weight: 600"><%= link_to @upcoming_outings_count, upcoming_admin_entourages_path %></div>
        <div class="text-muted">Sorties dans les 7 prochains jours</div>
      </div>
    </div>

    <div class="panel <%= @unanswered_count > 0 ? 'panel-warning' : 'panel-default' %>" style="flex: 1; min-width: 200px">
      <div class="panel-body" style="text-align: center">
        <div style="font-size: 30px; font-weight: 600"><%= link_to @unanswered_count, unanswered_admin_entourages_path %></div>
        <div class="text-muted">En attente de réponse (3j+)</div>
      </div>
    </div>

    <div class="panel <%= @photo_queue_count > 0 ? 'panel-warning' : 'panel-default' %>" style="flex: 1; min-width: 200px">
      <div class="panel-body" style="text-align: center">
        <div style="font-size: 30px; font-weight: 600"><%= link_to @photo_queue_count, moderate_admin_users_path %></div>
        <div class="text-muted">Photos de profil à modérer (total)</div>
      </div>
    </div>

    <% if @my_queue_count %>
      <div class="panel panel-default" style="flex: 1; min-width: 200px">
        <div class="panel-body" style="text-align: center">
          <div style="font-size: 30px; font-weight: 600"><%= link_to @my_queue_count, admin_entourages_path(moderator_id: current_user.id) %></div>
          <div class="text-muted">Dans ma file</div>
        </div>
      </div>
    <% end %>
  </div>
  <p class="text-muted" style="margin: -12px 0 20px">
    « Photos de profil à modérer » est un total cumulé : la donnée ne distingue pas une date d'entrée en file de la date de création du compte.
  </p>

  <div class="row" style="display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-start">
    <div class="panel panel-default" style="flex: 1; min-width: 320px">
      <div class="panel-heading">
        Comptes bloqués récemment
      </div>
      <div class="panel-body">
        <% if @recent_blocks.empty? %>
          <p class="text-muted">Aucun blocage dans les 48 dernières heures.</p>
        <% else %>
          <ul class="list-unstyled">
            <% @recent_blocks.each do |history| %>
              <li style="border-top: 1px solid #eee; padding: 8px 0">
                <%= link_to history.user&.full_name || "Utilisateur ##{history.user_id}", edit_admin_user_path(history.user_id) %>
                <div class="text-muted" style="font-size: 12px">
                  <%= l history.created_at, format: "%-d %B %Y à %H:%M" %>
                  <% if history.updater %>
                    &middot; par <%= history.updater.full_name %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

    <div class="panel panel-default" style="flex: 1; min-width: 320px">
      <div class="panel-heading" style="display: flex; justify-content: space-between; align-items: center">
        <span>Modérateurs les plus chargés</span>
        <%= link_to "voir tous", admin_moderator_workloads_path %>
      </div>
      <div class="panel-body">
        <% if @busiest_moderators.empty? %>
          <p class="text-muted">Aucun modérateur.</p>
        <% else %>
          <ul class="list-unstyled">
            <% @busiest_moderators.each do |row| %>
              <li style="border-top: 1px solid #eee; padding: 8px 0; display: flex; justify-content: space-between">
                <%= row[:moderator].full_name %>
                <span class="badge"><%= row[:open_count] %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>

  <div class="row" style="margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap">
    <%= link_to "Voir l'activité récente", admin_activity_feed_path, class: "btn btn-default" %>
  </div>
</div>
