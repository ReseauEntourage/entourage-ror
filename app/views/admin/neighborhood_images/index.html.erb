<div class="container">
  <div class="row">
    <div class="col-xs-offset-2 col-xs-8">
      <div class="title-container">
        <h1>Photos de groupe de voisinage</h1>
        <%= link_to "Ajouter une photo", new_admin_neighborhood_image_path, class: "btn btn-default" %>
      </div>

      <% if @neighborhood_images.empty? %>
        <div class="panel panel-warning">
          <div class="panel-heading">
            <h3 class="panel-title">Aucune photo n'est encore spécifiée.</h3>
          </div>
        </div>
      <% else %>
        <table class="custom-table">
          <thead>
            <th>Titre</th>
            <th>Photos</th>
          </thead>
          <% @neighborhood_images.each do |neighborhood_image| %>
            <tr>
              <td>
                <%= link_to neighborhood_image.title, edit_admin_neighborhood_image_path(neighborhood_image) %>
              </td>
              <td>
                <%= image_tag(NeighborhoodImage::image_url_for(neighborhood_image.image_url_medium_or_default), size: '225x96') if neighborhood_image.image_url_medium_or_default.present? %>
              </td>
              <td>
                <%= link_to "Modifier", edit_admin_neighborhood_image_path(neighborhood_image), class: "btn btn-default" %>
              </td>
            </tr>
          <% end %>
        </table>
      <% end %>
    </div>
  </div>
</div>
