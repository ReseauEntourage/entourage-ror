<div class="container">
  <div class="row">
    <div class="col-xs-offset-2 col-xs-8">
      <h1 style="display: flex; align-items: center; gap: 12px">
        <span style="flex-grow: 1">Équipes internes</span>
        <%= link_to "Créer une équipe", new_admin_partner_path(staff: true),
              class: "btn btn-success" %>
      </h1>

      <table class="table">
        <% @staff_teams.each do |partner| %>
          <tr>
            <td>
              <%= link_to partner.name, [:admin, partner] %>
            </td>
            <td>
              <%= link_to "Supprimer", [:admin, partner], method: :delete, class: "text-danger", data: { confirm: "Supprimer l'équipe \"#{partner.name}\" ?" } %>
            </td>
          </tr>
        <% end %>
      </table>

      <h1 style="display: flex; align-items: center; gap: 12px; margin-top: 32px">
        <span style="flex-grow: 1">Associations</span>
        <%= link_to "Créer une association", new_admin_partner_path,
              class: "btn btn-success" %>
      </h1>

      <table class="table">
        <% @partners.each do |partner| %>
          <% partner_admins = partner.users.pluck(:partner_admin) %>

          <tr>
            <td>
              <%= link_to partner.name, [:admin, partner] %>
            </td>
            <td><span class="badge" title="admins"><%= partner_admins.select { |is| is }.count %></span></td>
            <td><span class="badge" title="membres"><%= partner_admins.select { |is| !is }.count %></span></td>
            <td>
              <%= link_to "Supprimer", [:admin, partner], method: :delete, class: "text-danger", data: { confirm: "Supprimer l'association \"#{partner.name}\" ?" } %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  </div>
</div>
