<% category = @partner.staff ? "Équipes internes": "Associations" %>

<div class="container">
  <div class="row">
    <div class="col-xs-offset-2 col-xs-8">
      <ol class="breadcrumb">
        <li><%= link_to category, admin_partners_path %></li>
        <li><%= @partner.name %></li>
      </ol>

      <ul class="nav nav-tabs" role="tablist" style="margin-bottom: 2rem">
        <li role="presentation" class="active"><%= link_to "Membres", admin_partner_path(@partner) %></li>
        <li role="presentation"><%= link_to "Description", edit_admin_partner_path(@partner) %></li>
      </ul>

      <table class="table">
        <!-- Administrateurs -->
        <tr>
          <th colspan="2" style="border-top: none">
            <h2>Administrateurs</h2>
          </th>
        </tr>

        <% if @admins.empty? %>
          <tr>
            <td colspan="2">Cette organisation n'a pas d'administrateur.</td>
          </tr>
        <% end %>

        <% @admins.each do |user| %>
          <tr>
            <td><%= link_to UserPresenter.full_name(user), admin_user_path(user) %></td>
            <td>
              <%= link_to "Retirer des administrateurs", change_admin_role_admin_partners_path(user_id: user.id, admin: false), method: :post %>
            </td>
          </tr>
        <% end %>

        <!-- Membres -->
        <tr>
          <th colspan="2" style="border-top: none">
            <h2>Membres</h2>
          </th>
        </tr>

        <% if @members.empty? %>
          <tr>
            <td colspan="2">Cette organisation n'a pas de membres.</td>
          </tr>
        <% end %>

        <% @members.each do |user| %>
          <tr>
            <td><%= link_to UserPresenter.full_name(user), admin_user_path(user) %></td>
            <td>
              <%= link_to "Ajouter aux administrateurs", change_admin_role_admin_partners_path(user_id: user.id, admin: true), method: :post %>
            </td>
          </tr>
        <% end %>

        <!-- Abonnés -->
        <tr>
          <th colspan="2" style="border-top: none">
            <h2>Abonnés</h2>
          </th>
        </tr>

        <% if @followers.empty? %>
          <tr>
            <td colspan="2">Cette organisation n'a pas d'abonnés.</td>
          </tr>
        <% end %>

        <% @followers.each do |user| %>
          <tr>
            <td><%= link_to UserPresenter.full_name(user), admin_user_path(user) %></td>
            <td></td>
          </tr>
        <% end %>
      </table>

      <div class="h1" style="display: flex; align-items: center;">
        <div style="flex-grow: 1">Agendas OpenAgenda liés</div>
        <%= link_to "Lier un agenda OpenAgenda", new_admin_open_agenda_source_path(partner_id: @partner.id), class: "btn btn-default" %>
      </div>

      <% if @partner.open_agenda_sources.any? %>
        <table class="table">
          <% @partner.open_agenda_sources.each do |source| %>
            <tr>
              <td><%= link_to source.name, [:admin, source] %></td>
              <td><%= render partial: 'admin/open_agenda_sources/status_badge', locals: { source: source } %></td>
              <td><%= source.upcoming_events_count %> évén. à venir</td>
            </tr>
          <% end %>
        </table>
      <% else %>
        <p class="text-muted">Aucun agenda OpenAgenda lié à cette association pour le moment.</p>
      <% end %>
    </div>
  </div>
</div>
