<div style="display: flex; justify-content: center; padding-top: 60px">
  <div class="panel panel-default" style="width: 100%; max-width: 360px">
    <div class="panel-body" style="padding: 32px 28px">
      <h1 style="font-size: 22px; margin-bottom: 22px">Connexion</h1>

      <div id="flash">
        <%= display_flash_messages %>
      </div>

      <%= form_tag admin_sessions_path, html: {class: 'form-horizontal'} do %>
        <div class="field form-group">
          <%= text_field_tag :phone, nil, placeholder: "téléphone", class: 'form-control' %>
        </div>
        <div class="field form-group">
          <%= password_field_tag :admin_password, nil, placeholder: "mot de passe", class: 'form-control' %>
        </div>
        <%= hidden_field_tag :continue, params[:continue] %>
        <div class="actions form-group" style="margin-bottom: 16px">
          <%= link_to "Mot de passe oublié", new_admin_password_reset_path %>
        </div>
        <div class="actions form-group">
          <%= submit_tag "Connexion", class: "btn btn-lg btn-primary", style: "width: 100%" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
