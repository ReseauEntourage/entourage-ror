<style>
  .test-alert {
    display: flex;
    align-items: center;
    margin-top: 30px;
  }

  .test-alert-body {
    flex-grow: 1;
  }

  /* jobs */
  .alert-jobs { color: var(--bo-info); background-color: var(--bo-info-soft); border-color: transparent; }
  .btn-jobs { color: #fff; background-color: var(--bo-info); border-color: var(--bo-info); }

  /* notifications */
  .alert-notifications { color: var(--bo-dark); background-color: var(--bo-dark-soft); border-color: transparent; }
  .btn-notifications { color: #fff; background-color: var(--bo-dark); border-color: var(--bo-dark); }

  /* sms */
  .alert-sms { color: var(--bo-warning); background-color: var(--bo-warning-soft); border-color: transparent; }
  .btn-sms { color: #fff; background-color: var(--bo-warning); border-color: var(--bo-warning); }

  /* emails */
  .alert-emails { color: var(--bo-success); background-color: var(--bo-success-soft); border-color: transparent; }
  .btn-emails { color: #fff; background-color: var(--bo-success); border-color: var(--bo-success); }

  /* salesforce */
  .alert-salesforces { color: var(--bo-ink-soft); background-color: var(--bo-paper); border-color: var(--bo-line); }
  .btn-salesforces { color: var(--bo-ink); background-color: var(--bo-paper-raised); border-color: var(--bo-line-strong); }
</style>

<div class="container my-4">
  <h2>Outils de test</h2>

  <!-- Jobs -->
  <div id="push-notification-trigger-job">
    <div class="alert alert-jobs test-alert" role="alert">
      <div class="test-alert-body">
        <b>Jobs</b><br/>
        <b>Prérequis</b> : aucun.<br/>
        <b>Attendu</b> : pas de message d'erreur => job créé.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Push notification trigger job",
      push_notification_trigger_job_admin_testings_jobs_path(id: "push-notification-trigger-job"),
      method: :post,
      class: "btn btn-jobs",
      remote: true
    %>
  </div>

  <div id="notification-job">
    <div class="alert alert-jobs test-alert" role="alert">
      <div class="test-alert-body">
        <b>Jobs</b><br/>
        <b>Prérequis</b> : aucun.<br/>
        <b>Attendu</b> : pas de message d'erreur => job créé, recevoir une push notif.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Notification job",
      notification_job_admin_testings_jobs_path(id: "notification-job"),
      method: :post,
      class: "btn btn-jobs",
      remote: true
    %>
  </div>

  <!-- Notifications -->
  <div id="user-smalltalk-on-almost-match">
    <div class="alert alert-notifications test-alert" role="alert">
      <div class="test-alert-body">
        <b>Notifications</b><br/>
        <b>Prérequis</b> : avoir créé une demande, qu'elle ait déjà été matchée ou non.<br/>
        <b>Attendu</b> : recevoir une notification.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Almost match",
      user_smalltalk_on_almost_match_admin_testings_notifications_path(id: "user-smalltalk-on-almost-match"),
      method: :post,
      class: "btn btn-notifications",
      remote: true
    %>
  </div>

  <div id="user-reaction-on-create">
    <div class="alert alert-notifications test-alert" role="alert">
      <div class="test-alert-body">
        <b>Notifications</b><br/>
        <b>Prérequis</b> : un utilisateur doit avoir réagi à l'un de nos messages.<br/>
        <b>Attendu</b> : recevoir une notification.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "User reaction",
      user_reaction_on_create_admin_testings_notifications_path(id: "user-reaction-on-create"),
      method: :post,
      class: "btn btn-notifications",
      remote: true
    %>
  </div>

  <div id="ios-with-rpush">
    <div class="alert alert-notifications test-alert" role="alert">
      <div class="test-alert-body">
        <b>Notifications</b><br/>
        <b>Prérequis</b> : avoir un compte sur ios.<br/>
        <b>Attendu</b> : recevoir une notification.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Ios with rpush",
      ios_with_rpush_admin_testings_notifications_path(id: "ios-with-rpush"),
      method: :post,
      class: "btn btn-notifications",
      remote: true
    %>
  </div>

  <div id="ios-without-rpush">
    <div class="alert alert-notifications test-alert" role="alert">
      <div class="test-alert-body">
        <b>Notifications</b><br/>
        <b>Prérequis</b> : avoir un compte sur ios.<br/>
        <b>Attendu</b> : recevoir une notification.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Ios without rpush",
      ios_without_rpush_admin_testings_notifications_path(id: "ios-without-rpush"),
      method: :post,
      class: "btn btn-notifications",
      remote: true
    %>
  </div>

  <div id="android-with-rpush">
    <div class="alert alert-notifications test-alert" role="alert">
      <div class="test-alert-body">
        <b>Notifications</b><br/>
        <b>Prérequis</b> : avoir un compte sur android.<br/>
        <b>Attendu</b> : recevoir une notification.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Android with rpush",
      android_with_rpush_admin_testings_notifications_path(id: "android-with-rpush"),
      method: :post,
      class: "btn btn-notifications",
      remote: true
    %>
  </div>

  <div id="android-without-rpush">
    <div class="alert alert-notifications test-alert" role="alert">
      <div class="test-alert-body">
        <b>Notifications</b><br/>
        <b>Prérequis</b> : avoir un compte sur android.<br/>
        <b>Attendu</b> : recevoir une notification.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Android without rpush",
      android_without_rpush_admin_testings_notifications_path(id: "android-without-rpush"),
      method: :post,
      class: "btn btn-notifications",
      remote: true
    %>
  </div>

  <!-- Sms -->
  <div id="send-welcome">
    <div class="alert alert-sms test-alert" role="alert">
      <div class="test-alert-body">
        <b>Sms</b><br/>
        <b>Prérequis</b> : aucun.<br/>
        <b>Attendu</b> : recevoir une notification avec un code "xxxxxx".
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Send welcome", send_welcome_admin_testings_sms_path(id: "send-welcome"), method: :post, class: "btn btn-sms", remote: true %>
  </div>

  <div id="regenerate">
    <div class="alert alert-sms test-alert" role="alert">
      <div class="test-alert-body">
        <b>Sms</b><br/>
        <b>Prérequis</b> : aucun.<br/>
        <b>Attendu</b> : recevoir une notification avec un nouveau code.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Regenerate", regenerate_admin_testings_sms_path(id: "regenerate"), method: :post, class: "btn btn-sms", remote: true %>
  </div>

  <!-- Email -->
  <div id="weekly-planning">
    <div class="alert alert-emails test-alert" role="alert">
      <div class="test-alert-body">
        <b>Email</b><br/>
        <b>Prérequis</b> : des actions et événements doivent exister.<br/>
        <b>Attendu</b> : recevoir un email.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Weekly planning", weekly_planning_admin_testings_emails_path(id: "weekly-planning"), method: :post, class: "btn btn-emails", remote: true %>
  </div>

  <div class="alert alert-success test-alert" role="alert">
    <div class="test-alert-body">
      <b>Email</b><br/>
      <b>Prérequis</b> : l'admin doit avoir un email en @entourage.social si on est sur la recette.<br/>
      <b>Attendu</b> : recevoir un email de participation à un événement.
    </div>
  </div>

  <%= link_to "Outing participation reminder (6174429)", event_participation_reminder_admin_testings_emails_path, method: :post, class: "btn btn-success" %>

  <!-- Salesforce -->
  <div id="outing-sync">
    <div class="alert alert-salesforces test-alert" role="alert">
      <div class="test-alert-body">
        <b>Salesforce</b><br/>
        <b>Prérequis</b> : un événement pas encore synchronisé, en présentiel, créé par un admin ou un animateur Entourage, doit exister.<br/>
        <b>Attendu</b> : l'événement doit être créé sur Salesforce.
      </div>
    </div>

    <div data-type="results"></div>

    <%= link_to "Synchronisation", outing_sync_admin_testings_salesforce_index_path(id: "outing-sync"), method: :post, class: "btn btn-salesforces", remote: true %>
  </div>
</div>
