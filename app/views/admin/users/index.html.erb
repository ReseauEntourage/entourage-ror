<h1>Liste des utilisateurs</h1>

<%= form_tag admin_users_path, class: 'form-inline', method: :get do |f| %>
  <div class="panel panel-default">
    <div class="panel-body" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px">
      <div class='input-group'>
        <%= text_field_tag :search, @params[:search], class: "form-control", placeholder: "nom, prénom, email..." %>
        <span class="input-group-btn">
          <%= submit_tag "Chercher", class: "btn btn-default" %>
        </span>
      </div>

      <%= link_to "Nouvel utilisateur", new_admin_user_path, class: "btn btn-success" %>
    </div>

    <div style="padding: 0 0 15px 15px">
      <div class='input-group'>
        <%= select_tag :profile, options_for_select([['Tous les profils', nil]] + user_profiles, @params[:profile]), class: 'form-control' %>
      </div>
      <div class='input-group'>
        <%= select_tag :engagement, options_for_select([['Tous les engagements', nil]] + user_engagements, @params[:engagement]), class: 'form-control' %>
      </div>
      <div class="input-group">
        <%= select_tag :role, options_for_select([['Tous les rôles', nil]] + user_roles, @params[:role]), class: 'form-control' %>
      </div>
      <div class="input-group">
        <%= select_tag :status, options_for_select([['Tous les statuts', nil]] + user_statuses, @params[:status]), class: 'form-control' %>
      </div>
      <div class="input-group">
        <%= select_tag "interests[]", options_for_select(user_interests, @params[:interests]), multiple: true, class: 'form-control', style: 'height: auto', title: "Centres d'intérêt" %>
      </div>
    </div>

    <% q = @params[:q] || {} %>
    <div style="padding: 0 0 15px 15px">
      <div class="input-group">
        <label style="margin: 0 4px 0 0; font-weight: normal">Inscrit(e) entre</label>
        <%= date_field_tag "q[created_at_gteq]", q[:created_at_gteq], class: "form-control", style: "width: auto; display: inline-block" %>
        <label style="margin: 0 4px">et</label>
        <%= date_field_tag "q[created_at_lteq]", q[:created_at_lteq], class: "form-control", style: "width: auto; display: inline-block" %>
      </div>
      <div class="input-group">
        <label style="margin: 0 4px 0 0; font-weight: normal">Dernière connexion entre</label>
        <%= date_field_tag "q[last_sign_in_at_gteq]", q[:last_sign_in_at_gteq], class: "form-control", style: "width: auto; display: inline-block" %>
        <label style="margin: 0 4px">et</label>
        <%= date_field_tag "q[last_sign_in_at_lteq]", q[:last_sign_in_at_lteq], class: "form-control", style: "width: auto; display: inline-block" %>
      </div>
    </div>
  </div>

  <%
    q = @params[:q] || {}
    locations = moderation_area_filters
  %>

  <%= hidden_field_tag "q[country_eq]", q[:country_eq] if q[:country_eq] %>
  <%= hidden_field_tag "q[postal_code_start]", q[:postal_code_start] if q[:postal_code_start] %>
  <%= hidden_field_tag "q[postal_code_not_start_all]", q[:postal_code_not_start_all] if q[:postal_code_not_start_all] %>

  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin: 10px 0">
    <div class="btn-group btn-group-sm">
      <% location_keys = [:country_eq, :postal_code_start, :postal_code_not_start_all] %>
      <% active = locations.key q.slice(*location_keys).compact.symbolize_keys %>

      <%= link_to("Partout", @params.merge(q: q.except(*location_keys)), class: "btn btn-#{(!@params.keys.include? 'q') ? :primary : :default}") %>

      <% locations.sort.each do |name, options| %>
        <% if (name != "Partout") %>
          <%= link_to(name, @params.merge(q: q.except(*location_keys).merge(options)),
            class: "btn btn-#{active == name ? :primary : :default}"
          ) %>
        <% end %>
      <% end %>
    </div>

    <div>
      <%= link_to "Télécharger", download_list_export_admin_users_path(@params), class: "btn btn-default" %>
      <%= link_to "Réinitialiser les filtres", admin_users_path, class: "btn btn-default" %>
    </div>
  </div>
<% end %>

<% if @status == :pending %>
  <div class="panel panel-info" style="clear: both">
    <div class="panel-heading">
      En attente
    </div>
    <div class="panel-body">
      Les utilisateurs affichés ici ont fait une demande de changement de téléphone qui est en attente de modération.
    </div>
  </div>
<% end %>

<%= form_tag bulk_block_admin_users_path, method: :post, id: "bulk_actions_form" do %>
  <div class="panel panel-default">
    <div class="panel-body" style="display: flex; align-items: center; gap: 10px">
      <span id="bulk_actions_count" class="text-muted">Aucun utilisateur sélectionné</span>
      <%= text_field_tag :cnil_explanation, nil, class: "form-control", placeholder: "Raisons du blocage (obligatoire)", style: "max-width: 400px" %>
      <%= submit_tag "Bloquer la sélection", class: "btn btn-danger btn-sm",
            data: { confirm: "Bloquer les comptes sélectionnés ?" } %>
    </div>
  </div>

  <table class="table custom-table" style="table-layout: auto">
    <thead>
      <th><input type="checkbox" id="select_all_users"></th>
      <th>Nom</th>
      <th>Prénom</th>
      <th>Association</th>

    <% if @status == :pending %>
      <th>Email lié au compte</th>
      <th>Date de la demande</th>
    <% elsif @status == :temporary_blocked %>
      <th>Notification de déblocage le</th>
    <% else %>
      <th>Date de création</th>
      <th>Date de dernière connexion</th>
    <% end %>

    <th>Code postal</th>
    <th>Profil</th>
    <th>Engagement</th>

    <% if [:admin, :moderators].include? @role %>
      <th>Rôle modérateur</th>
    <% end %>
  </thead>

  <% @users.each do |user| %>
    <tr>
      <td><%= check_box_tag "user_ids[]", user.id, false, class: "user_checkbox", id: "user_#{user.id}" %></td>
      <td><%= link_to user.last_name,  edit_admin_user_path(user)%></td>
      <td><%= link_to user.first_name,  edit_admin_user_path(user)%></td>
      <td>
        <% if user.partner %>
          <%= user.partner.name %>
        <% else %>
          <span class="text-muted">&mdash;</span>
        <% end %>
      </td>

      <% if @status == :pending %>
        <td><%= user.email %></td>
        <td><%= l user.pending_phone_change_request.created_at, format: "%-d %B %Y" %></td>
      <% elsif @status == :temporary_blocked %>
        <td><%= l user.unblock_at, format: "%-d %B %Y" %></td>
      <% else %>
        <td><%= l user.created_at, format: "%-d %B %Y" %></td>
        <td>
          <% if user.last_sign_in_at %>
            <%= l user.last_sign_in_at, format: "%-d %B %Y" %>
          <% else %>
            <span class="text-muted">&mdash;</span>
          <% end %>
        </td>
      <% end %>

      <td><%= user.postal_code %></td>
      <td>
        <% if user.targeting_profile.present? %>
          <span class="custom-badge info" title="Profil renseigné par la modération">
            <%= t "community.entourage.targeting_profiles.#{user.targeting_profile}" %>
          </span>
        <% elsif user.goal.present? %>
          <span class="custom-badge info" title="Profil renseigné par l'utilisateur">
            <%= t "community.entourage.goals_compact.#{user.goal}" %>
          </span>
        <% end %>
      </td>
      <td>
        <span class="custom-badge <%= user.engagement.engaged? ? 'success' : 'info' %>"><%= user.engagement.badge %></span>
      </td>

      <% if [:admin, :moderators].include? @role %>
        <td>
          <% if user.moderator %>
            <span class="custom-badge" title="moderator">modérateur</span>
          <% end %>
        </td>
      <% end %>
    </tr>
  <% end %>
  </table>
<% end %>

<%= page_entries_info @users, entry_name: 'utilisateurs' %>
<div class="container">
  <%= paginate @users %>
</div>

<script>
  $(function(){
    $('form select:not([multiple])').on('change', function(event) {
      $(event.target).closest('form').submit();
    })

    var updateBulkCount = function() {
      var count = $('#bulk_actions_form .user_checkbox:checked').length;
      $('#bulk_actions_count').text(count > 0 ? count + ' utilisateur(s) sélectionné(s)' : 'Aucun utilisateur sélectionné');
    };

    $('#select_all_users').on('change', function(event) {
      $('#bulk_actions_form .user_checkbox').prop('checked', $(event.target).prop('checked'));
      updateBulkCount();
    });

    $('#bulk_actions_form').on('change', '.user_checkbox', updateBulkCount);
  })
</script>
