<%= render 'header', tab: :neighborhoods %>

<div class="alert alert-info" role="alert" style="display: flex; align-items: center">
  <div style="flex-grow: 1">
    <%= @user.full_name %> est membre de <%= @join_requests.select{ |join_request| join_request.accepted? }.count %> groupes de voisins.
  </div>
</div>

<div class="row">
  <label class="control-label">Groupes de voisins</label>
  <table class="table">
    <tr>
      <th>Nom</th>
      <th>Posts créés</th>
      <th>Commentaires créés</th>
      <th>Posts non lus</th>
    </tr>
    <% @join_requests.each do |join_request| %>
      <% neighborhood = Neighborhood.unscoped.find(join_request.joinable_id) %>

      <% chat_messages = neighborhood.chat_messages.pluck(:user_id, :ancestry) %>

      <tr>
        <td><%= neighborhood.name %></td>
        <td><%= chat_messages.count { |user_id, ancestry| @user.id == user_id && ancestry.nil? } %></td>
        <td><%= chat_messages.count { |user_id, ancestry| @user.id == user_id && !ancestry.nil? } %></td>
        <td><%= join_request.unread_messages_count %></td>
      </tr>
    <% end %>
  </table>
</div>

<div class="row">
  <label class="control-label">Contenus créés par <%= @user.first_name %></label>
  <table class="table">
    <tr>
      <th>Groupe</th>
      <th>Type</th>
      <th>Date</th>
      <th>Extrait</th>
      <th>Statut</th>
      <th></th>
    </tr>
    <% if @created_content.empty? %>
      <tr>
        <td colspan="6" class="text-muted">Aucun contenu créé dans un groupe de voisins.</td>
      </tr>
    <% end %>
    <% @created_content.each do |item| %>
      <tr>
        <td><%= item[:group].name %></td>
        <td><%= item[:kind] == :post ? 'Post' : 'Commentaire' %></td>
        <td><%= l item[:message].created_at, format: "%-d %B %Y à %H:%M" %></td>
        <td><%= item[:extrait] %></td>
        <td><%= item[:status_label] %></td>
        <td>
          <% if item[:kind] == :post %>
            <%= link_to "Voir", show_posts_admin_neighborhood_path(item[:group]) %>
          <% else %>
            <%= link_to "Voir", show_post_comments_admin_neighborhood_path(item[:group], post_id: item[:message].parent_id) %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
</div>
